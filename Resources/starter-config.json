{
  "version": 1,
  "server": { "port": 8765 },
  "global": [
    { "id": "g_safari", "type": "app", "bundleId": "com.apple.Safari" },
    { "id": "g_notes", "type": "app", "bundleId": "com.apple.Notes" },
    { "id": "g_terminal", "type": "app", "bundleId": "com.apple.Terminal" },
    { "id": "g_textedit", "type": "app", "bundleId": "com.apple.TextEdit" }
  ],
  "pages": [
    {
      "bundleId": "com.apple.Notes",
      "columns": null,
      "buttons": [
        { "id": "n_hello", "type": "text", "label": "Hello", "emoji": "👋", "text": "Hello from ShortcutPhone" },
        { "id": "n_thanks", "type": "text", "label": "Thanks", "emoji": "🙏", "text": "Thanks, got it 👍" },
        { "id": "n_new", "type": "keys", "label": "New note", "emoji": "📝", "keys": "cmd+n" }
